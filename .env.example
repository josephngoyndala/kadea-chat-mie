# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Base de données PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=app

# E-mails (Brevo en SMTP)
MAIL_MAILER=smtp
MAIL_FROM_NAME=Kadea Chat
MAIL_FROM_ADDRESS=your-email@example.com
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=TON_IDENTIFIANT_SMTP
SMTP_PASSWORD=TON_MOT_DE_PASSE_SMTP

# Stockage des fichiers : fs (disque local) en développement, s3 en production
DRIVE_DISK=fs
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=eu-west-1
S3_BUCKET=avatars
S3_ENDPOINT=
S3_PUBLIC_URL=

# Limiteur de requêtes
LIMITER_STORE=database
