@layouts.auth({ title: 'Créer un compte' })
  <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand">Bienvenue chez Kadea</p>
  <h1 class="mt-4 text-[34px] font-extrabold leading-tight tracking-[-0.03em] sm:text-5xl">
    Créez votre compte
  </h1>
  <p class="mt-3 text-[15px] text-muted">Rejoignez la communauté et commencez à échanger.</p>

  @form({
    route: 'new_account.store',
    method: 'POST',
    class: 'mt-8 flex flex-col gap-5',
    'x-data': '{ submitting: false }',
    'x-on:submit': 'submitting = true',
  })
    @field.root({ name: 'fullName' })
      @!field.label({ text: 'Nom complet' })
      @!input.control({
        autocomplete: 'name',
        placeholder: 'Ex. Joël Mukendi',
        icon: 'lucide:user',
      })
      @!field.error()
    @end

    @field.root({ name: 'email' })
      @!field.label({ text: 'Adresse e-mail' })
      @!input.control({
        type: 'email',
        autocomplete: 'email',
        placeholder: 'vous@exemple.com',
        icon: 'lucide:mail',
      })
      @!field.error()
    @end

    @field.root({ name: 'password' })
      @!field.label({ text: 'Mot de passe' })
      @!input.control({
        type: 'password',
        autocomplete: 'new-password',
        placeholder: '8 caractères minimum',
        icon: 'lucide:lock',
      })
      @!field.error()
    @end

    @field.root({ name: 'passwordConfirmation' })
      @!field.label({ text: 'Confirmer le mot de passe' })
      @!input.control({
        type: 'password',
        autocomplete: 'new-password',
        placeholder: 'Répétez votre mot de passe',
        icon: 'lucide:lock',
      })
      @!field.error()
    @end

    <label class="flex cursor-pointer items-start gap-3 text-sm text-ink">
      <input type="checkbox" name="acceptTerms" required class="mt-0.5 size-5 shrink-0 rounded accent-brand" />
      <span>
        J'accepte les
        <a href="#" class="font-semibold text-brand hover:underline">conditions d'utilisation</a>
        et la politique de confidentialité.
      </span>
    </label>

    @button({ type: 'submit', block: true, 'x-bind:disabled': 'submitting' })
      <span x-show="!submitting" class="inline-flex items-center gap-2">
        Créer mon compte
        @svg('lucide:chevron-right', { width: 18, height: 18 })
      </span>
      <span x-show="submitting" x-cloak class="inline-flex items-center gap-2">
        @svg('lucide:loader-circle', { width: 18, height: 18, class: 'animate-spin' })
        Création du compte…
      </span>
    @end
  @end

  <p class="mt-8 text-center text-sm text-muted">
    Vous avez déjà un compte ?
    @link({ route: 'session.create', class: 'font-bold text-brand hover:underline' })
      Se connecter
    @end
  </p>
@end