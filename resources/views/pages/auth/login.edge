@layouts.auth({ title: 'Connexion' })
  <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand">Heureux de vous revoir</p>
  <h1 class="mt-4 text-[34px] font-extrabold leading-tight tracking-[-0.03em] sm:text-5xl">
    Connectez-vous
  </h1>
  <p class="mt-3 text-[15px] text-muted">Retrouvez vos conversations et votre communauté.</p>
  @form({
    route: 'session.store',
    method: 'POST',
    class: 'mt-8 flex flex-col gap-5',
    'x-data': '{ submitting: false }',
    'x-on:submit': 'submitting = true',
  })
    @field.root({ name: 'email' })
      @!field.label({ text: 'Adresse e-mail' })
      @!input.control({
        type: 'email',
        autocomplete: 'username',
        placeholder: 'vous@exemple.com',
        icon: 'lucide:mail',
      })
      @!field.error()
    @end
    @field.root({ name: 'password' })
      @!field.label({ text: 'Mot de passe' })
      @!input.control({
        type: 'password',
        autocomplete: 'current-password',
        placeholder: 'Votre mot de passe',
        icon: 'lucide:lock',
      })
      @!field.error()
    @end

    <div class="flex items-center justify-between gap-4 text-sm">
      <label class="flex cursor-pointer items-center gap-2 text-muted">
        <input type="checkbox" name="remember" class="size-[18px] rounded accent-brand" />
        
        Se souvenir de moi

      </label>
      @link({
        route: 'password_reset.create',
        class: 'font-bold text-brand hover:underline',
      })
        Mot de passe oublié ?
      @end
    </div>
    @button({ type: 'submit', block: true, 'x-bind:disabled': 'submitting' })
      <span x-show="!submitting" class="inline-flex items-center gap-2">
        
        Se connecter

        @svg('lucide:chevron-right', { width: 18, height: 18 })
      </span>
      <span x-show="submitting" x-cloak class="inline-flex items-center gap-2">
        @svg('lucide:loader-circle', { width: 18, height: 18, class: 'animate-spin' })
        
        Connexion…

      </span>
    @end
  @end

  <p class="mt-8 text-center text-sm text-muted">
    
    Vous n'avez pas encore de compte ?

    @link({ route: 'new_account.create', class: 'font-bold text-brand hover:underline' })
      Créer un compte
    @end
  </p>
@end
