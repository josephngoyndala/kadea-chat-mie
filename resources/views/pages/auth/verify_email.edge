@layouts.auth({ title: 'Vérifiez votre boîte mail' })
  <span class="grid size-16 place-items-center rounded-2xl bg-brand-50 text-brand">
    @svg('lucide:mail-check', { width: 30, height: 30 })
  </span>

  <p class="mt-8 text-xs font-bold uppercase tracking-[0.2em] text-brand">Dernière étape</p>
  <h1 class="mt-4 text-[34px] font-extrabold leading-tight tracking-[-0.03em] sm:text-5xl">
    Vérifiez votre boîte mail
  </h1>

  <p class="mt-3 text-[15px] leading-relaxed text-muted">
    @if(email)
      Nous avons envoyé un lien de confirmation à
      <strong class="font-bold text-ink">{{ email }}</strong>
      .
      Cliquez dessus pour activer votre compte. Le lien est valable 24 heures.
    @else
      Entrez votre adresse e-mail pour recevoir un nouveau lien de confirmation.
    @end
  </p>
  @form({
    route: 'email_verification.resend',
    method: 'POST',
    class: 'mt-8 flex flex-col gap-5',
    'x-data': '{ submitting: false }',
    'x-on:submit': 'submitting = true',
  })
    @if(email)
      <input type="hidden" name="email" value="{{ email }}" />
    @else
      @field.root({ name: 'email' })
        @!field.label({ text: 'Adresse e-mail' })
        @!input.control({
          type: 'email',
          autocomplete: 'email',
          placeholder: 'vous@exemple.com',
          icon: 'lucide:mail',
        })
        @!field.error()
      @end
    @end
    @button({
      type: 'submit',
      variant: 'secondary',
      block: true,
      'x-bind:disabled': 'submitting',
    })
      <span x-show="!submitting">Renvoyer l'e-mail</span>
      <span x-show="submitting" x-cloak class="inline-flex items-center gap-2">
        @svg('lucide:loader-circle', { width: 18, height: 18, class: 'animate-spin' })
        
        Envoi en cours…

      </span>
    @end
  @end

  <p class="mt-6 text-sm text-muted">
    Rien reçu ? Regardez dans vos courriers indésirables, ou patientez une minute avant de renvoyer l'e-mail.
  </p>

  <p class="mt-8 text-center text-sm text-muted">
    
    Adresse déjà confirmée ?

    @link({ route: 'session.create', class: 'font-bold text-brand hover:underline' })
      Se connecter
    @end
  </p>
@end
