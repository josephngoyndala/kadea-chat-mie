@layouts.auth({ title: 'Nouveau mot de passe' })
  <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand">Presque terminé</p>
  <h1 class="mt-4 text-[34px] font-extrabold leading-tight tracking-[-0.03em] sm:text-5xl">
    Choisissez un nouveau mot de passe
  </h1>
  <p class="mt-3 text-[15px] leading-relaxed text-muted">
    Il doit contenir au moins 8 caractères.
  </p>

  @form({
    route: 'password_reset.update',
    routeParams: { token: token },
    method: 'POST',
    class: 'mt-8 flex flex-col gap-5',
    'x-data': '{ submitting: false }',
    'x-on:submit': 'submitting = true',
  })
    @field.root({ name: 'password' })
      @!field.label({ text: 'Nouveau mot de passe' })
      @!input.control({
        type: 'password',
        autocomplete: 'new-password',
        placeholder: '8 caractères minimum',
        icon: 'lucide:lock',
      })
      @!field.error()
    @end

    @field.root({ name: 'passwordConfirmation' })
      @!field.label({ text: 'Confirmer le mot de passe' })
      @!input.control({
        type: 'password',
        autocomplete: 'new-password',
        placeholder: 'Répétez votre mot de passe',
        icon: 'lucide:lock',
      })
      @!field.error()
    @end

    @button({ type: 'submit', block: true, 'x-bind:disabled': 'submitting' })
      <span x-show="!submitting" class="inline-flex items-center gap-2">
        Enregistrer le mot de passe
        @svg('lucide:chevron-right', { width: 18, height: 18 })
      </span>
      <span x-show="submitting" x-cloak class="inline-flex items-center gap-2">
        @svg('lucide:loader-circle', { width: 18, height: 18, class: 'animate-spin' })
        Enregistrement…
      </span>
    @end
  @end
@end