@layouts.auth({ title: 'Mot de passe oublié' })
  <span class="grid size-16 place-items-center rounded-2xl bg-brand-50 text-brand">
    @svg('lucide:key-round', { width: 30, height: 30 })
  </span>

  <p class="mt-8 text-xs font-bold uppercase tracking-[0.2em] text-brand">Pas de panique</p>
  <h1 class="mt-4 text-[34px] font-extrabold leading-tight tracking-[-0.03em] sm:text-5xl">
    Mot de passe oublié ?
  </h1>
  <p class="mt-3 text-[15px] leading-relaxed text-muted">
    Saisissez l'adresse e-mail de votre compte. Nous vous enverrons un lien, valable 1 heure, pour choisir un nouveau mot de passe.
  </p>
  @form({
    route: 'password_reset.store',
    method: 'POST',
    class: 'mt-8 flex flex-col gap-5',
    'x-data': '{ submitting: false }',
    'x-on:submit': 'submitting = true',
  })
    @field.root({ name: 'email' })
      @!field.label({ text: 'Adresse e-mail' })
      @!input.control({
        type: 'email',
        autocomplete: 'email',
        placeholder: 'vous@exemple.com',
        icon: 'lucide:mail',
      })
      @!field.error()
    @end
    @button({ type: 'submit', block: true, 'x-bind:disabled': 'submitting' })
      <span x-show="!submitting" class="inline-flex items-center gap-2">
        
        Envoyer le lien

        @svg('lucide:chevron-right', { width: 18, height: 18 })
      </span>
      <span x-show="submitting" x-cloak class="inline-flex items-center gap-2">
        @svg('lucide:loader-circle', { width: 18, height: 18, class: 'animate-spin' })
        
        Envoi en cours…

      </span>
    @end
  @end

  <p class="mt-8 text-center text-sm text-muted">
    
    Vous vous en souvenez ?

    @link({ route: 'session.create', class: 'font-bold text-brand hover:underline' })
      Se connecter
    @end
  </p>
@end
