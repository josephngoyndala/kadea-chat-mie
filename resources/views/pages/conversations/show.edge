@layouts.messenger({ title: header.title })
  <div class="flex min-h-0 flex-1">
    {{-- Liste : visible à côté de la discussion à partir de 1024 px --}}
    <aside class="hidden min-h-0 w-[380px] flex-none flex-col border-r border-line lg:flex">
      @include('partials/conversation_list')
    </aside>

    <section
      class="flex min-h-0 min-w-0 flex-1 flex-col bg-paper"
      x-data="conversationChat"
      x-on:submit="handleSubmit($event)"
      data-conversation-id="{{ activeId }}"
      data-message-url="{{ urlFor('messages.show', { conversationId: activeId, messageId: '0' }) }}"
      data-catch-up-url="{{ urlFor('messages.index', { conversationId: activeId }) }}"
    >
      <header class="flex flex-none items-center gap-3 border-b border-line bg-white px-3 py-3 sm:px-4">
        <a
          href="{{ urlFor('dashboard') }}"
          aria-label="Retour aux discussions"
          class="grid size-11 flex-none place-items-center rounded-full text-ink transition hover:bg-paper lg:hidden"
        >
          @svg('lucide:arrow-left', { width: 22, height: 22 })
        </a>

        @if(header.avatarUrl)
          @!avatar({ src: header.avatarUrl, name: header.title, size: 44 })
        @else
          @!avatar({ initials: header.initials, size: 44 })
        @end

        <div class="min-w-0 flex-1">
          @if(header.isGroup)
            <a href="{{ urlFor('group_members.index', { conversationId: activeId }) }}" class="block min-w-0">
              <h1 class="truncate text-base font-bold tracking-tight">{{ header.title }}</h1>
              <p class="truncate text-xs text-muted">
                {{ header.memberCount }} membre{{ header.memberCount > 1 ? 's' : '' }} · Appuyez pour voir le groupe
              </p>
            </a>
          @else
            <h1 class="truncate text-base font-bold tracking-tight">{{ header.title }}</h1>
          @end
        </div>
      </header>

      {{-- Messages --}}
      <div class="relative flex min-h-0 flex-1 flex-col">
        <div
          x-ref="list"
          x-on:scroll.passive="onScroll()"
          class="flex min-h-0 flex-1 flex-col overflow-y-auto px-4 py-4"
        >
          @if(!groups.length)
            <div data-empty class="my-auto flex flex-col items-center gap-3 text-center">
              <span class="grid size-16 place-items-center rounded-2xl bg-white text-brand shadow-card">
                @svg('lucide:hand-heart', { width: 28, height: 28 })
              </span>
              <p class="max-w-xs text-sm text-muted">
                Aucun message pour l'instant. Dites bonjour à {{ header.title }} !
              </p>
            </div>
          @end

          <div x-ref="messages" class="flex flex-col gap-2">
            @each(group in groups)
              <p data-day-label class="mx-auto my-3 w-fit rounded-full bg-white px-3 py-1 text-xs font-semibold text-muted shadow-card">
                {{ group.label }}
              </p>
              @each(message in group.messages)
                @!messageBubble({ message: message, conversationId: activeId })
              @end
            @end
          </div>
        </div>

        {{-- Nouveaux messages pendant que l'on lit plus haut --}}
        <button
          type="button"
          x-show="unseen > 0"
          x-cloak
          x-transition
          x-on:click="scrollToBottom()"
          class="absolute bottom-3 left-1/2 inline-flex -translate-x-1/2 cursor-pointer items-center gap-2 rounded-full bg-ink px-4 py-2.5 text-sm font-semibold text-white shadow-card"
        >
          @svg('lucide:arrow-down', { width: 16, height: 16 })
          <span x-text="unseen > 1 ? unseen + ' nouveaux messages' : '1 nouveau message'"></span>
        </button>
      </div>

      {{-- Saisie --}}
      <div class="flex-none border-t border-line bg-white">
        <p
          x-show="offline"
          x-cloak
          role="status"
          class="flex items-center gap-2 bg-brand-50 px-4 py-2 text-sm font-medium text-brand"
        >
          @svg('lucide:loader-circle', { width: 16, height: 16, class: 'animate-spin' })
          Connexion perdue, reconnexion en cours…
        </p>

        <p x-show="error" x-cloak x-text="error" role="alert" class="px-4 pt-3 text-sm font-medium text-brand"></p>

        @form({
          route: 'messages.store',
          routeParams: { conversationId: activeId },
          method: 'POST',
          class: 'flex items-end gap-2 p-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] sm:p-4',
          'x-ref': 'form',
          'x-on:submit.prevent': 'send($event)',
        })
          <label for="message-body" class="sr-only">Votre message</label>
          <textarea
            id="message-body"
            name="body"
            rows="1"
            maxlength="2000"
            required
            enterkeyhint="send"
            placeholder="Écrire un message…"
            x-ref="field"
            x-model="draft"
            x-on:input="autosize()"
            x-on:keydown="onKeydown($event)"
            class="max-h-36 min-h-12 flex-1 resize-none rounded-3xl border border-line bg-paper px-4 py-3 text-[15px] leading-6 outline-none transition placeholder:text-[#8d8d8d] focus:border-brand focus:bg-white focus:ring-4 focus:ring-brand/15"
          ></textarea>

          <button
            type="submit"
            x-bind:disabled="!canSend"
            aria-label="Envoyer"
            class="grid size-12 flex-none cursor-pointer place-items-center rounded-full bg-brand text-white shadow-brand transition active:scale-95 disabled:cursor-not-allowed disabled:opacity-50 disabled:shadow-none"
          >
            <span x-show="!sending" class="grid place-items-center">
              @svg('lucide:send-horizontal', { width: 20, height: 20 })
            </span>
            <span x-show="sending" x-cloak class="grid place-items-center">
              @svg('lucide:loader-circle', { width: 20, height: 20, class: 'animate-spin' })
            </span>
          </button>
        @end
      </div>
    </section>
  </div>
@end