@layouts.marketing()
  <section class="overflow-x-clip">
    <div class="mx-auto grid max-w-7xl items-center gap-16 px-6 pb-20 pt-32 sm:px-10 lg:grid-cols-[1.05fr_1fr] lg:pb-28 lg:pt-44">
      <div>
        <p class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.2em] text-brand">
          <span class="h-0.5 w-10 bg-brand"></span>
          La messagerie de Kadea Academy
        </p>

        <h1 class="mt-8 text-[44px] font-extrabold leading-[0.98] tracking-[-0.04em] sm:text-7xl lg:text-[88px]">
          Apprendre ensemble.<br />
          <span class="text-brand">Échanger autrement.</span>
        </h1>

        <p class="mt-8 max-w-md text-lg leading-relaxed text-muted">
          Retrouvez votre communauté, partagez vos idées et faites avancer vos projets dans un espace simple, rapide et sécurisé.
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-5">
          @if(auth.user)
            @button({ route: 'dashboard', arrow: true })
              Ouvrir mes discussions
            @end
          @else
            @button({ route: 'new_account.create', arrow: true })
              Rejoindre Kadea Chat
            @end
            <a href="{{ urlFor('session.create') }}" class="border-b-2 border-ink pb-1 text-[15px] font-bold transition hover:border-brand hover:text-brand">
              J'ai déjà un compte
            </a>
          @end
        </div>

        <div class="mt-12 flex items-center gap-4">
          <div class="flex -space-x-2">
            @!avatar({ initials: 'gm', size: 38, class: 'ring-2 ring-white' })
            @!avatar({ initials: 'jb', size: 38, tone: 'light', class: 'ring-2 ring-white' })
            @!avatar({ initials: 'si', size: 38, tone: 'dark', class: 'ring-2 ring-white' })
          </div>
          <div>
            <p class="text-sm font-bold">Une communauté active</p>
            <p class="text-sm text-muted">Étudiants, mentors et équipes réunis.</p>
          </div>
        </div>
      </div>

      {{-- Aperçu décoratif de la messagerie --}}
      <div aria-hidden="true" class="relative mx-auto w-full max-w-xl lg:max-w-none">
        <div class="absolute -right-4 -top-6 h-[85%] w-[88%] rounded-[36px] bg-brand sm:-right-8 lg:-right-10 lg:-top-10">
          <span class="absolute right-8 top-3 text-8xl font-black leading-none text-white/20">K</span>
        </div>

        <div class="relative mt-10 overflow-hidden rounded-3xl border border-line bg-white shadow-[0_40px_80px_-40px_rgba(23,23,23,0.45)]">
          <div class="flex items-center justify-between border-b border-line px-5 py-3.5">
            <div class="flex gap-1.5">
              <span class="size-2 rounded-full bg-brand"></span>
              <span class="size-2 rounded-full bg-line"></span>
              <span class="size-2 rounded-full bg-line"></span>
            </div>
            <span class="text-[11px] font-semibold text-muted">Kadea Chat</span>
          </div>

          <div class="grid min-h-[300px] grid-cols-[40%_60%] sm:min-h-[340px]">
            <div class="border-r border-line p-4 sm:p-5">
              <p class="text-sm font-bold">Discussions</p>
              <div class="mt-4 h-9 rounded-xl bg-paper"></div>
              <div class="mt-4 flex flex-col gap-1">
                <div class="flex items-center gap-3 rounded-xl bg-paper p-2.5">
                  <span class="size-9 shrink-0 rounded-full bg-line"></span>
                  <span class="flex flex-1 flex-col gap-1.5">
                    <span class="h-2 w-3/4 rounded bg-ink/80"></span>
                    <span class="h-1.5 w-full rounded bg-line"></span>
                  </span>
                </div>
                <div class="flex items-center gap-3 p-2.5">
                  <span class="size-9 shrink-0 rounded-full bg-line"></span>
                  <span class="flex flex-1 flex-col gap-1.5">
                    <span class="h-2 w-2/3 rounded bg-ink/70"></span>
                    <span class="h-1.5 w-full rounded bg-line"></span>
                  </span>
                </div>
                <div class="flex items-center gap-3 p-2.5">
                  <span class="size-9 shrink-0 rounded-full bg-line"></span>
                  <span class="flex flex-1 flex-col gap-1.5">
                    <span class="h-2 w-1/2 rounded bg-ink/70"></span>
                    <span class="h-1.5 w-full rounded bg-line"></span>
                  </span>
                </div>
              </div>
            </div>

            <div class="flex flex-col bg-paper">
              <div class="flex items-center gap-3 border-b border-line bg-white px-4 py-3.5">
                <span class="size-9 rounded-xl bg-brand-50"></span>
                <div>
                  <p class="text-[13px] font-bold leading-tight">Équipe Web</p>
                  <p class="text-[11px] text-muted">3 membres</p>
                </div>
              </div>
              <div class="flex flex-1 flex-col justify-end gap-3 p-4 pb-8">
                <p class="max-w-[85%] self-start rounded-2xl rounded-bl-md bg-white px-4 py-2.5 text-xs shadow-card">
                  Bonjour l'équipe, on fait le point ?
                </p>
                <p class="max-w-[85%] self-end rounded-2xl rounded-br-md bg-brand px-4 py-2.5 text-xs font-medium text-white">
                  Oui, la nouvelle interface est prête.
                </p>
                <p class="max-w-[85%] self-start rounded-2xl rounded-bl-md bg-white px-4 py-2.5 text-xs shadow-card">
                  Excellent travail !
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="absolute -bottom-5 right-2 flex items-center gap-3 rounded-2xl border border-line bg-white px-4 py-3 shadow-card sm:-right-3">
          <span class="grid size-9 place-items-center rounded-xl bg-brand text-white">
            @svg('lucide:check', { width: 18, height: 18 })
          </span>
          <span>
            <span class="block text-[13px] font-bold leading-tight">Message reçu</span>
            <span class="block text-[11px] text-muted">À l'instant</span>
          </span>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-ink text-white">
    <div class="mx-auto grid max-w-7xl divide-y divide-white/15 md:grid-cols-3 md:divide-x md:divide-y-0">
      <div class="px-6 py-10 sm:px-10">
        <h2 class="text-base font-bold">Instantané</h2>
        <p class="mt-2 text-sm text-white/70">Vos messages arrivent sans recharger la page.</p>
      </div>
      <div class="px-6 py-10 sm:px-10">
        <h2 class="text-base font-bold">Ensemble</h2>
        <p class="mt-2 text-sm text-white/70">Échangez en privé ou créez votre groupe.</p>
      </div>
      <div class="px-6 py-10 sm:px-10">
        <h2 class="text-base font-bold">Sécurisé</h2>
        <p class="mt-2 text-sm text-white/70">Vos conversations restent entre leurs membres.</p>
      </div>
    </div>
  </section>
@end