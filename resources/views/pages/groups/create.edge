@layouts.app({ title: 'Nouveau groupe' })
  @page({
    title: 'Nouveau groupe',
    description:
      "Donnez un nom au groupe et choisissez ses membres. Vous en serez l'administrateur.",
  })
    @form({
      route: 'groups.store',
      method: 'POST',
      class: 'flex w-full min-w-0 max-w-2xl flex-col gap-5',
      'x-data': 'groupPicker',
    })
      @field.root({ name: 'name' })
        @!field.label({ text: 'Nom du groupe' })
        @!input.control({
          autocomplete: 'off',
          maxlength: 60,
          placeholder: 'Ex. Promotion Web 2026',
          icon: 'lucide:users-round',
          'x-init': 'name = $el.value',
          'x-on:input': 'name = $event.target.value',
        })
        @!field.error()
      @end
      @field.root({ name: 'memberIds' })
        <div class="flex flex-col gap-3">
          <div class="flex items-center justify-between gap-3">
            <span class="text-sm font-semibold text-ink">Membres</span>
            <span
              class="text-sm text-muted"
              x-text="selected.length + (selected.length > 1 ? ' sélectionnés' : ' sélectionné')"
            ></span>
          </div>

          <div class="relative">
            <span
              class="pointer-events-none absolute inset-y-0 left-0 grid w-12 place-items-center text-muted"
            >
              @svg('lucide:search', { width: 20, height: 20 })
            </span>
            <input
              type="search"
              x-model="query"
              autocomplete="off"
              placeholder="Filtrer par nom ou adresse e-mail"
              aria-label="Filtrer les membres"
              class="h-14 w-full min-w-0 rounded-field border border-line bg-white pl-12 pr-4 text-[15px] outline-none transition placeholder:text-[#8d8d8d] focus:border-brand focus:ring-4 focus:ring-brand/15"
            />
          </div>
          @if(members.length)
            <ul
              class="max-h-[50dvh] divide-y divide-line overflow-y-auto rounded-3xl border border-line bg-white shadow-card"
            >
              @each(person in members)
                <li
                  data-search="{{ person.searchText }}"
                  x-show="visible($el.dataset.search)"
                  class="relative flex items-center gap-3 p-3 transition hover:bg-paper"
                >
                  <div class="relative z-10 flex-none">
                    @if(person.avatarUrl)
                      @!avatar({ src: person.avatarUrl, name: person.name, size: 44 })
                    @else
                      @!avatar({ initials: person.initials, size: 44 })
                    @end
                  </div>

                  <label
                    class="flex min-w-0 flex-1 cursor-pointer items-center gap-3 after:absolute after:inset-0"
                  >
                    <span class="min-w-0 flex-1">
                      <span class="block truncate text-[15px] font-bold">{{ person.name }}</span>
                      <span class="block truncate text-xs text-muted">
                        {{ person.maskedEmail }}
                      </span>
                    </span>
                    <input
                      type="checkbox"
                      name="memberIds[]"
                      value="{{ person.id }}"
                      x-model="selected"
                      class="relative z-10 size-5 flex-none accent-brand"
                    />
                  </label>
                </li>
              @end
            </ul>
          @else
            <p
              class="rounded-3xl border border-line bg-white px-6 py-10 text-center text-sm text-muted shadow-card"
            >
              Aucun autre membre confirmé pour l'instant. Invitez vos camarades à créer leur compte !
            </p>
          @end
          @!field.error()
        </div>
      @end
      @button({
        type: 'submit',
        block: true,
        arrow: true,
        'x-bind:disabled': '!canSubmit',
      })
        Créer le groupe
      @end
    @end
  @end
@end
