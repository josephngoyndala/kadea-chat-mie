@layouts.app({ title: 'Mes discussions' })
  <div class="grid min-h-[calc(100vh-4rem)] place-items-center px-6">
    <div class="flex max-w-sm flex-col items-center gap-4 text-center">
      <span class="grid size-16 place-items-center rounded-2xl bg-brand-50 text-brand">
        @svg('lucide:messages-square', { width: 28, height: 28 })
      </span>
      <h1 class="text-2xl font-extrabold tracking-tight">Aucune discussion pour l'instant</h1>
      <p class="text-muted">
        Recherchez un utilisateur pour démarrer votre première conversation, ou créez un groupe.
      </p>
    </div>
  </div>
@end