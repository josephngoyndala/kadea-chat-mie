<div
  class="flex min-h-0 flex-1 flex-col bg-white"
  x-data="conversationList"
  data-user-id="{{ auth?.user?.id }}"
  data-active-id="{{ activeId ?? '' }}"
  data-card-url="{{ urlFor('conversations.card', { id: '0' }) }}"
  data-dashboard-url="{{ urlFor('dashboard') }}"
>
  <div class="flex flex-none items-center justify-between gap-3 px-4 pb-3 pt-4 sm:pt-5">
    <h1 class="text-2xl font-extrabold tracking-tight">Discussions</h1>
    <div class="flex items-center gap-2">
      @button({ route: 'groups.create', variant: 'secondary', size: 'sm' })
        @svg('lucide:users-round', { width: 16, height: 16 })
        Groupe
      @end
      @button({ route: 'users.index', size: 'sm' })
        @svg('lucide:square-pen', { width: 16, height: 16 })
        Nouvelle
      @end
    </div>
  </div>

  <ul
    x-ref="items"
    class="divide-y divide-line overflow-y-auto border-t border-line {{ conversations.length ? 'min-h-0 flex-1' : 'hidden' }}"
  >
    @each(item in conversations)
      @!conversationCard({ ...item, active: item.id === activeId })
    @end
  </ul>

  @if(!conversations.length)
    <div data-list-empty class="flex flex-1 flex-col items-center justify-center gap-4 border-t border-line px-8 text-center">
      <span class="grid size-16 place-items-center rounded-2xl bg-brand-50 text-brand">
        @svg('lucide:messages-square', { width: 28, height: 28 })
      </span>
      <div>
        <h2 class="text-lg font-bold tracking-tight">Aucune discussion</h2>
        <p class="mt-1 text-sm text-muted">Recherchez un utilisateur pour démarrer votre première conversation, ou créez un groupe.</p>
      </div>
      @button({ route: 'users.index', arrow: true })
        Nouvelle discussion
      @end
    </div>
  @end
</div>