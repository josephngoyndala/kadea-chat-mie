{{-- Bouton clair / sombre : le choix est mémorisé dans le navigateur --}}
<button
  type="button"
  x-data="{
    dark: document.documentElement.classList.contains('dark'),
    toggle() {
      this.dark = !this.dark
      document.documentElement.classList.toggle('dark', this.dark)
      try {
        localStorage.setItem('theme', this.dark ? 'dark' : 'light')
      } catch (error) {}
    },
  }"
  x-on:click="toggle()"
  x-bind:aria-pressed="dark"
  class="inline-flex h-11 cursor-pointer items-center gap-2 rounded-xl border border-line bg-white px-4 text-sm font-semibold text-ink transition hover:bg-paper active:scale-95"
>
  <span x-show="!dark" class="inline-flex items-center gap-2">
    @svg('lucide:moon', { width: 18, height: 18 })
    Passer au thème sombre
  </span>
  <span x-show="dark" x-cloak class="inline-flex items-center gap-2">
    @svg('lucide:sun', { width: 18, height: 18 })
    Passer au thème clair
  </span>
</button>
