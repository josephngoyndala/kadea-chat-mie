@let(pageTitle = $props.get('title'))
<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#e4203d" />
    <title>
      {{
        pageTitle
          ? `${pageTitle} · Kadea Chat`
          : 'Kadea Chat · La messagerie de Kadea Academy'
      }}
    </title>
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body class="min-h-screen bg-white">
    <header class="absolute inset-x-0 top-0 z-10">
      <div
        class="mx-auto flex w-full max-w-7xl items-center justify-between px-6 py-5 sm:px-10 sm:py-6"
      >
        @!logo({ size: 40 })
        <nav class="flex items-center gap-2 sm:gap-6">
          <a
            href="/"
            class="hidden px-2 text-[15px] font-semibold text-ink/80 transition hover:text-ink sm:inline"
          >
            Accueil
          </a>
          @if(auth?.user)
            @button({ route: 'dashboard', variant: 'dark', size: 'nav' })
              Mes discussions
            @end
          @else
            <a
              href="{{ urlFor('session.create') }}"
              class="hidden px-2 text-[15px] font-semibold text-ink/80 transition hover:text-ink sm:inline"
            >
              Se connecter
            </a>
            @button({ route: 'new_account.create', variant: 'dark', size: 'nav' })
              Créer un compte
            @end
          @end
        </nav>
      </div>
    </header>
    {{{ await $slots.main() }}}
    @include('partials/flash_alerts')
  </body>
</html>
