@let(pageTitle = $props.get('title'))
<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#e4203d" />
    <title>{{ pageTitle ? `${pageTitle} · Kadea Chat` : 'Kadea Chat' }}</title>
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body class="min-h-screen bg-paper">
    <header class="sticky top-0 z-20 border-b border-line bg-white">
      <div class="flex h-16 items-center justify-between px-4 sm:px-6">
        @!logo({ size: 34 })
        <div class="flex items-center gap-3">
          @if(auth.user)
            @!avatar({ initials: auth.user.initials, size: 36 })
          @end
          @form({ route: 'session.destroy', method: 'POST' })
            @button({ type: 'submit', variant: 'secondary', size: 'sm' })
              @svg('lucide:log-out', { width: 15, height: 15 })
              Déconnexion
            @end
          @end
        </div>
      </div>
    </header>

    <div class="min-h-[calc(100vh-4rem)]">{{{ await $slots.main() }}}</div>
    @include('partials/flash_alerts')
  </body>
</html>