@let(pageTitle = $props.get('title'))
@let(currentUser = auth?.user)
@let(currentAvatarUrl = currentUser?.avatarPath ? await driveUrl(currentUser.avatarPath) : null)
<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#e4203d" />
    <title>{{ pageTitle ? `${pageTitle} · Kadea Chat` : 'Kadea Chat' }}</title>
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body class="min-h-screen overflow-x-clip bg-paper">
    <header class="sticky top-0 z-20 border-b border-line bg-white">
      <div class="mx-auto flex h-16 w-full max-w-7xl items-center justify-between gap-3 px-4 sm:px-6">
        @!logo({ size: 34, compact: true })

        {{-- Navigation dans l'en-tête : à partir de 640 px --}}
        <nav class="hidden items-center gap-1 sm:flex" aria-label="Navigation principale">
          @navLink({ route: 'dashboard', class: 'rounded-xl px-3 py-2 text-sm font-semibold text-muted transition hover:text-ink aria-[current=page]:bg-paper aria-[current=page]:text-ink' })
            Discussions
          @end
          @navLink({ route: 'profile.show', class: 'rounded-xl px-3 py-2 text-sm font-semibold text-muted transition hover:text-ink aria-[current=page]:bg-paper aria-[current=page]:text-ink' })
            Profil
          @end
        </nav>

        <div class="flex items-center gap-2 sm:gap-3">
          @if(currentUser)
            @if(currentAvatarUrl)
              @!avatar({ src: currentAvatarUrl, name: currentUser.fullName, size: 36 })
            @else
              @!avatar({ initials: currentUser.initials, size: 36 })
            @end
          @end

          @form({ route: 'session.destroy', method: 'POST' })
            <button
              type="submit"
              aria-label="Déconnexion"
              class="grid size-11 cursor-pointer place-items-center rounded-xl border border-line text-ink transition hover:bg-paper sm:hidden"
            >
              @svg('lucide:log-out', { width: 18, height: 18 })
            </button>
            <div class="hidden sm:block">
              @button({ type: 'submit', variant: 'secondary', size: 'sm' })
                @svg('lucide:log-out', { width: 15, height: 15 })
                Déconnexion
              @end
            </div>
          @end
        </div>
      </div>
    </header>

    <div class="min-h-[calc(100dvh-4rem)] pb-20 sm:pb-0">{{{ await $slots.main() }}}</div>

    {{-- Barre de navigation du bas : téléphone uniquement --}}
    <nav
      class="fixed inset-x-0 bottom-0 z-20 flex border-t border-line bg-white pb-[env(safe-area-inset-bottom)] sm:hidden"
      aria-label="Navigation principale"
    >
      @navLink({ route: 'dashboard', class: 'flex flex-1 flex-col items-center gap-1 py-2.5 text-xs font-semibold text-muted transition aria-[current=page]:text-brand' })
        @svg('lucide:messages-square', { width: 22, height: 22 })
        Discussions
      @end
      @navLink({ route: 'profile.show', class: 'flex flex-1 flex-col items-center gap-1 py-2.5 text-xs font-semibold text-muted transition aria-[current=page]:text-brand' })
        @svg('lucide:user-round', { width: 22, height: 22 })
        Profil
      @end
    </nav>

    @include('partials/photo_lightbox')
    @include('partials/flash_alerts')
  </body>
</html>