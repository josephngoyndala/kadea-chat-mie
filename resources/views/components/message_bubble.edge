@let(message = $props.get('message'))
@let(conversationId = $props.get('conversationId'))
@let(actionParams = { conversationId: conversationId, messageId: message.id })
@let(authorColors = [
  'text-rose-600',
  'text-sky-600',
  'text-emerald-600',
  'text-amber-600',
  'text-violet-600',
  'text-teal-600',
])
@let(statusLabels = { sent: 'Envoyé', delivered: 'Reçu', read: 'Lu' })

<div
  id="message-{{ message.id }}"
  data-message-id="{{ message.id }}"
  x-data="messageBubble"
  x-on:keydown.escape="close()"
  class="flex {{ message.isMine ? 'justify-end' : 'justify-start' }}"
>
  <div
    class="flex min-w-0 max-w-[85%] flex-col sm:max-w-[70%] {{ message.isMine ? 'items-end' : 'items-start' }}"
  >
    {{-- Pièces jointes : hors de la bulle, ouverture au clic et téléchargement --}}
    @if(!message.isDeleted && message.attachments?.length)
      <div
        class="flex min-w-0 max-w-full flex-col gap-1.5 {{ message.isMine ? 'items-end' : 'items-start' }}"
      >
        @if(message.authorName && !message.body)
          <p class="px-1 text-xs font-bold {{ authorColors[message.authorColor] }}">
            {{ message.authorName }}
          </p>
        @end
        @each(file in message.attachments)
          @let(fileUrl = await driveUrl(file.storagePath))
          @if(file.isImage)
            <div
              class="relative w-72 max-w-full overflow-hidden rounded-2xl bg-white shadow-card ring-1 ring-line sm:w-80"
            >
              <button
                type="button"
                data-zoom-src="{{ fileUrl }}"
                data-zoom-alt="{{ file.originalName }}"
                aria-label="Agrandir la photo {{ file.originalName }}"
                class="block w-full cursor-zoom-in"
              >
                <img
                  src="{{ fileUrl }}"
                  alt="{{ file.originalName }}"
                  class="h-auto max-h-80 w-full object-cover"
                  loading="lazy"
                />
              </button>
              <button
                type="button"
                data-download-url="{{ fileUrl }}"
                data-download-name="{{ file.originalName }}"
                aria-label="Télécharger la photo"
                title="Télécharger"
                class="absolute right-2 top-2 grid size-9 cursor-pointer place-items-center rounded-full bg-black/55 text-white backdrop-blur transition hover:bg-black/75 active:scale-95"
              >
                @svg('lucide:download', { width: 17, height: 17 })
              </button>
            </div>
          @elseif(file.isVideo)
            <div
              class="relative w-72 max-w-full overflow-hidden rounded-2xl bg-black shadow-card ring-1 ring-line sm:w-80"
            >
              <video controls playsinline preload="metadata" class="max-h-80 w-full">
                <source src="{{ fileUrl }}" type="{{ file.mimeType }}" />
              </video>
              <button
                type="button"
                data-download-url="{{ fileUrl }}"
                data-download-name="{{ file.originalName }}"
                aria-label="Télécharger la vidéo"
                title="Télécharger"
                class="absolute right-2 top-2 grid size-9 cursor-pointer place-items-center rounded-full bg-black/55 text-white backdrop-blur transition hover:bg-black/75 active:scale-95"
              >
                @svg('lucide:download', { width: 17, height: 17 })
              </button>
            </div>
          @else
            <div
              class="flex w-72 max-w-full items-center gap-3 rounded-2xl border border-line bg-white px-3 py-2.5 text-ink shadow-card sm:w-80"
            >
              <span
                class="grid size-10 flex-none place-items-center rounded-xl bg-brand-50 text-brand"
              >
                @svg('lucide:file-text', { width: 20, height: 20 })
              </span>
              <span class="min-w-0 flex-1">
                <span class="block truncate text-sm font-semibold">{{ file.originalName }}</span>
                <span class="block text-xs text-muted">{{ file.sizeLabel }}</span>
              </span>
              <a
                href="{{ fileUrl }}"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Ouvrir le fichier"
                title="Ouvrir"
                class="grid size-9 flex-none place-items-center rounded-full text-muted transition hover:bg-paper hover:text-ink"
              >
                @svg('lucide:external-link', { width: 17, height: 17 })
              </a>
              <button
                type="button"
                data-download-url="{{ fileUrl }}"
                data-download-name="{{ file.originalName }}"
                aria-label="Télécharger le fichier"
                title="Télécharger"
                class="grid size-9 flex-none cursor-pointer place-items-center rounded-full bg-brand-50 text-brand transition hover:bg-brand hover:text-white"
              >
                @svg('lucide:download', { width: 17, height: 17 })
              </button>
            </div>
          @end
        @end
      </div>
    @end

    @if(message.isDeleted || message.body)
      {{-- La bulle du texte : un appui ouvre le menu d'actions --}}
      <div
        x-show="mode !== 'edit'"
        role="button"
        tabindex="0"
        x-on:click="toggle()"
        x-on:keydown.enter="toggle()"
        class="min-w-0 max-w-full cursor-pointer rounded-2xl px-3.5 py-1.5 {{ message.attachments?.length && !message.isDeleted ? 'mt-1.5' : '' }} {{
          message.isDeleted
            ? 'border border-dashed border-line text-muted'
            : message.isMine
              ? 'rounded-br-md bg-brand text-white'
              : 'rounded-bl-md bg-white text-ink shadow-card'
        }}"
      >
        @if(message.authorName && !message.isDeleted)
          <p class="mb-0.5 text-xs font-bold {{ authorColors[message.authorColor] }}">
            {{ message.authorName }}
          </p>
        @end
        @if(message.isDeleted)
          <p class="flex items-center gap-1.5 text-sm italic">
            @svg('lucide:ban', { width: 14, height: 14 })
            Ce message a été supprimé
          </p>
        @else
          <p data-message-body class="whitespace-pre-wrap text-[15px] leading-snug [overflow-wrap:anywhere]">{{ message.body }}</p>
        @end

        <p
          class="mt-0.5 flex items-center justify-end gap-1 text-[11px] leading-none {{
            message.isDeleted
              ? 'text-muted'
              : message.isMine
                ? 'text-white/70'
                : 'text-muted'
          }}"
        >
          <span>{{ message.isEdited ? 'modifié · ' : '' }}{{ message.time }}</span>
          {{-- Statut : un trait = envoyé, deux traits = reçu, deux traits bleus = lu --}}
          @if(message.isMine && !message.isDeleted && message.status)
            <span
              data-message-status="{{ message.status }}"
              title="{{ statusLabels[message.status] }}"
              class="inline-flex items-center {{ message.status === 'read' ? 'text-sky-300' : 'text-white/70' }}"
            >
              @if(message.status === 'sent')
                @svg('lucide:check', { width: 15, height: 15 })
              @else
                @svg('lucide:check-check', { width: 15, height: 15 })
              @end
              <span class="sr-only">{{ statusLabels[message.status] }}</span>
            </span>
          @end
        </p>
      </div>
    @else
      {{-- Pièces jointes seules : l'heure, le statut et le menu d'actions sous les fichiers --}}
      <div class="mt-1 flex items-center gap-1.5 px-1 text-[11px] leading-none text-muted">
        <span>{{ message.time }}</span>
        @if(message.isMine && message.status)
          <span
            data-message-status="{{ message.status }}"
            title="{{ statusLabels[message.status] }}"
            class="inline-flex items-center {{ message.status === 'read' ? 'text-sky-500' : 'text-muted' }}"
          >
            @if(message.status === 'sent')
              @svg('lucide:check', { width: 15, height: 15 })
            @else
              @svg('lucide:check-check', { width: 15, height: 15 })
            @end
            <span class="sr-only">{{ statusLabels[message.status] }}</span>
          </span>
        @end
        <button
          type="button"
          x-on:click="toggle()"
          aria-label="Options du message"
          title="Options"
          class="grid size-6 cursor-pointer place-items-center rounded-full text-muted transition hover:bg-white hover:text-ink"
        >
          @svg('lucide:ellipsis', { width: 15, height: 15 })
        </button>
      </div>
    @end
    {{-- Éditeur : remplace la bulle pendant la modification --}}
    @if(message.canEdit)
      <div x-show="mode === 'edit'" x-cloak class="w-[min(80vw,28rem)]">
        @form({
          route: 'messages.update',
          routeParams: actionParams,
          method: 'POST',
          class: 'flex flex-col gap-2',
          'data-message-edit': true,
        })
          <label for="edit-{{ message.id }}" class="sr-only">Modifier le message</label>
          <textarea
            id="edit-{{ message.id }}"
            name="body"
            rows="2"
            maxlength="2000"
            required
            x-ref="editField"
            x-on:keydown.escape.stop="cancelEdit()"
            class="w-full resize-none rounded-2xl border border-brand bg-white px-4 py-3 text-[15px] leading-6 outline-none ring-4 ring-brand/15"
          >{{ message.body }}</textarea>
          <div class="flex justify-end gap-2">
            <button
              type="button"
              x-on:click="cancelEdit()"
              class="inline-flex min-h-11 cursor-pointer items-center rounded-xl px-4 text-sm font-semibold text-muted transition hover:bg-white"
            >
              Annuler
            </button>
            <button
              type="submit"
              class="inline-flex min-h-11 cursor-pointer items-center rounded-xl bg-brand px-4 text-sm font-semibold text-white"
            >
              Enregistrer
            </button>
          </div>
        @end
      </div>
    @end
    {{-- Menu d'actions --}}
    <div
      x-show="menu && mode === 'actions'"
      x-cloak
      x-transition
      class="mt-1.5 flex flex-wrap items-center gap-1"
    >
      @if(message.canEdit)
        <button
          type="button"
          x-on:click="startEdit()"
          class="inline-flex min-h-11 cursor-pointer items-center gap-1.5 rounded-xl px-3 text-sm font-semibold text-muted transition hover:bg-white hover:text-ink"
        >
          @svg('lucide:pencil', { width: 15, height: 15 })
          Modifier
        </button>
      @end

      <button
        type="button"
        x-on:click="mode = 'delete'"
        class="inline-flex min-h-11 cursor-pointer items-center gap-1.5 rounded-xl px-3 text-sm font-semibold text-muted transition hover:bg-white hover:text-brand"
      >
        @svg('lucide:trash-2', { width: 15, height: 15 })
        Supprimer
      </button>
    </div>
    {{-- Choix du type de suppression --}}
    <div
      x-show="menu && mode === 'delete'"
      x-cloak
      x-transition
      class="mt-1.5 flex flex-wrap items-center gap-1"
    >
      @form({
        route: 'messages.destroy',
        routeParams: actionParams,
        method: 'POST',
        'data-message-delete': 'me',
      })
        <input type="hidden" name="scope" value="me" />
        <button
          type="submit"
          class="inline-flex min-h-11 cursor-pointer items-center rounded-xl px-3 text-sm font-semibold text-muted transition hover:bg-white hover:text-brand"
        >
          Pour moi
        </button>
      @end
      @if(message.canDeleteForEveryone)
        @form({
          route: 'messages.destroy',
          routeParams: actionParams,
          method: 'POST',
          'data-message-delete': 'everyone',
        })
          <input type="hidden" name="scope" value="everyone" />
          <button
            type="submit"
            class="inline-flex min-h-11 cursor-pointer items-center rounded-xl bg-brand px-4 text-sm font-semibold text-white"
          >
            Pour tous
          </button>
        @end
      @end

      <button
        type="button"
        x-on:click="mode = 'actions'"
        class="inline-flex min-h-11 cursor-pointer items-center rounded-xl px-3 text-sm font-semibold text-muted transition hover:bg-white"
      >
        Retour
      </button>
    </div>
  </div>
</div>
