@let(nameInitials = $props.get('initials'))
@let(size = $props.get('size', 44))
@let(tones = {
  brand: 'bg-brand text-white',
  light: 'bg-[#e4e4e4] text-ink',
  dark: 'bg-ink text-white',
})
@let(classes = ['grid shrink-0 place-items-center rounded-full object-cover font-bold', tones[$props.get('tone', 'brand')]])
@let(boxStyle = `width: ${size}px; height: ${size}px; font-size: ${Math.round(size * 0.36)}px;`)

@if($props.get('src'))
  <img {{
    $props
      .except(['initials', 'name', 'size', 'tone'])
      .merge({ class: classes, style: boxStyle, alt: $props.get('name') ?? '' })
      .toAttrs()
  }} />
@elseif(nameInitials)
  <span {{
    $props
      .except(['initials', 'name', 'src', 'size', 'tone'])
      .merge({ class: classes, style: boxStyle })
      .toAttrs()
  }}>
    {{ nameInitials.toUpperCase() }}
  </span>
@end