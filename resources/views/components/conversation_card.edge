@let(cardId = $props.get('id'))
@let(cardTitle = $props.get('title'))
@let(cardAvatarUrl = $props.get('avatarUrl'))
@let(isActive = $props.get('active', false))
@let(isGroup = $props.get('isGroup', false))
@let(unreadCount = Number($props.get('unreadCount', 0)))

{{-- La carte entière ouvre la discussion (lien étiré), sauf la photo, qui s'agrandit. --}}
<li
  data-conversation-id="{{ cardId }}"
  data-title="{{ cardTitle }}"
  data-is-group="{{ isGroup ? '1' : '0' }}"
  data-unread-count="{{ unreadCount }}"
  class="relative flex items-center gap-3 px-4 py-3 transition {{ isActive ? 'bg-brand-50' : 'hover:bg-paper' }}"
>
  <div class="relative z-10 flex-none">
    @if(cardAvatarUrl)
      @!avatar({ src: cardAvatarUrl, name: cardTitle, size: 52 })
    @else
      @!avatar({ initials: $props.get('initials'), size: 52 })
    @end
  </div>

  <a
    href="{{ urlFor('conversations.show', { id: cardId }) }}"
    aria-current="{{ isActive ? 'page' : 'false' }}"
    class="flex min-w-0 flex-1 flex-col gap-0.5 after:absolute after:inset-0"
  >
    <span class="flex items-baseline justify-between gap-3">
      <span class="flex min-w-0 items-center gap-1.5">
        @if(isGroup)
          <span class="text-muted flex-none" title="Groupe">
            @svg('lucide:users', { width: 14, height: 14 })
          </span>
        @end
        <span class="truncate text-[15px] {{ unreadCount > 0 ? 'font-extrabold text-ink' : 'font-bold text-ink' }}">{{ cardTitle }}</span>
      </span>
      <span class="flex-none text-xs {{ unreadCount > 0 ? 'font-bold text-brand' : 'text-muted' }}">{{ $props.get('time') }}</span>
    </span>

    <span class="flex items-center justify-between gap-2">
      <span class="truncate text-sm {{ unreadCount > 0 ? 'font-semibold text-ink' : 'text-muted' }}">{{ $props.get('preview') }}</span>
      @if(unreadCount > 0)
        <span
          data-badge
          class="flex h-5 min-w-5 flex-none items-center justify-center rounded-full bg-brand px-1.5 text-[11px] font-bold text-white shadow-brand ring-2 ring-white animate-in zoom-in-50 duration-200"
        >
          {{ unreadCount > 99 ? '99+' : unreadCount }}
        </span>
      @end
    </span>
  </a>
</li>