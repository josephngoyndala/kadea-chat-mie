@let(src = $props.get('src'))
@let(alt = $props.get('alt', 'Photo'))

<div
  x-data="{ open: false }"
  x-effect="document.body.classList.toggle('overflow-hidden', open)"
  x-on:keydown.escape.window="open = false"
  class="inline-flex"
>
  <button
    type="button"
    x-on:click="open = true"
    aria-label="Agrandir la photo"
    aria-haspopup="dialog"
    class="cursor-zoom-in rounded-full transition active:scale-95"
  >
    {{{ await $slots.main() }}}
  </button>

  <template x-teleport="body">
    <div
      x-show="open"
      x-cloak
      x-transition.opacity
      x-on:click="open = false"
      role="dialog"
      aria-modal="true"
      aria-label="{{ alt }}"
      class="fixed inset-0 z-50 flex items-center justify-center bg-black/85 p-4"
    >
      <button
        type="button"
        x-on:click="open = false"
        aria-label="Fermer"
        class="absolute right-4 top-4 grid size-11 cursor-pointer place-items-center rounded-full bg-white/15 text-white transition hover:bg-white/25"
      >
        @svg('lucide:x', { width: 22, height: 22 })
      </button>

      <img
        src="{{ src }}"
        alt="{{ alt }}"
        x-on:click.stop
        class="max-h-[85dvh] max-w-full rounded-2xl object-contain shadow-2xl"
      />
    </div>
  </template>
</div>