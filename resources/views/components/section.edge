@let(sectionTitle = $props.get('title'))
@let(sectionDescription = $props.get('description'))

<section class="not-first:mt-6 not-first:border-t not-first:border-line not-first:pt-6">
  @if(sectionTitle || sectionDescription)
    <header class="mb-4">
      @if(sectionTitle)
        <h2 class="text-[15px] font-bold tracking-tight">{{ sectionTitle }}</h2>
      @end
      @if(sectionDescription)
        <p class="mt-0.5 text-sm text-muted">{{ sectionDescription }}</p>
      @end
    </header>
  @end

  <div class="flex flex-col gap-5">{{{ await $slots.main() }}}</div>
</section>